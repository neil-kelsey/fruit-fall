; Engine configuration file.
config_version=5

[application]

config/name="Fruit Fall"
config/description="An ukiyo-e fruit-merging puzzle."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.96, 0.91, 0.8, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
2d/default_gravity=2600.0
2d/solver/solver_iterations=24
2d/sleep_threshold_linear=4.0
2d/time_before_sleep=0.4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.1, 0.2, 1)
